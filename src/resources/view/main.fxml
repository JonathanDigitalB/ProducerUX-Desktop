<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jonathan.producerux.controller.MainController">
   <top>
      <Label styleClass="title" text="Descarga y escucha, reproduce y disfruta" wrapText="true" alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets top="40.0" left="24.0" right="24.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="24.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="32.0" right="32.0" bottom="32.0" />
         </padding>
         <Button styleClass="primary-button" text="Descargar Video MP4" maxWidth="Infinity" onAction="#openVideo" />
         <Button styleClass="primary-button" text="Descargar Audio MP3" maxWidth="Infinity" onAction="#openAudio" />
         <Button styleClass="secondary-button" text="Salir" maxWidth="Infinity" onAction="#exitApp">
            <VBox.margin>
               <Insets top="24.0" />
            </VBox.margin>
         </Button>
      </VBox>
   </center>
</BorderPane>
