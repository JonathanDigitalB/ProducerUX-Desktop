<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jonathan.producerux.controller.AudioController">
   <content>
      <VBox spacing="10.0" styleClass="page">
         <fx:define>
            <ToggleGroup fx:id="nameGroup" />
         </fx:define>
         <Label styleClass="title" text="Descargar Audio MP3" alignment="CENTER" maxWidth="Infinity" />
         <TextField fx:id="linkField" promptText="Pega aquí el link del video">
            <VBox.margin>
               <Insets top="14.0" />
            </VBox.margin>
         </TextField>
         <Label styleClass="section" text="Nombre del archivo">
            <VBox.margin>
               <Insets top="10.0" />
            </VBox.margin>
         </Label>
         <RadioButton text="Nombre original del video" selected="true" toggleGroup="$nameGroup" />
         <RadioButton fx:id="rbNameCustom" text="Nombre personalizado" toggleGroup="$nameGroup" />
         <TextField fx:id="nameField" promptText="Escribe el nombre" />
         <Button fx:id="downloadButton" styleClass="primary-button" text="Descargar" maxWidth="Infinity" onAction="#onDownload">
            <VBox.margin>
               <Insets top="14.0" />
            </VBox.margin>
         </Button>
         <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0.0" />
         <Label fx:id="statusLabel" styleClass="status" wrapText="true" alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity" />
         <Button styleClass="secondary-button" text="Volver" maxWidth="Infinity" onAction="#onBack" />
      </VBox>
   </content>
</ScrollPane>
